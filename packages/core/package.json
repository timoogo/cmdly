{
  "name": "@cmdly/core",
  "description": "Headless command and workflow engine",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timoogo/cmdly.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/timoogo/cmdly#readme",
  "bugs": {
    "url": "https://github.com/timoogo/cmdly/issues"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
